{"id":4000,"clientId":1839,"createdOn":1741879127000,"modifiedOn":1742407176000,"ownedBy":22342,"folderId":3231,"name":"UAN Template","type":"BROADCAST","content":"<!doctype html>\n<html lang=\"und\" dir=\"auto\" xmlns=\"http://www.w3.org/1999/xhtml\" xmlns:v=\"urn:schemas-microsoft-com:vml\" xmlns:o=\"urn:schemas-microsoft-com:office:office\">\n\n<head>\n  <title></title>\n  <!--[if !mso]><!-->\n  <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n  <!--<![endif]-->\n  <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <style type=\"text/css\">\n    #outlook a {\n      padding: 0;\n    }\n\n    body {\n      margin: 0;\n      padding: 0;\n      -webkit-text-size-adjust: 100%;\n      -ms-text-size-adjust: 100%;\n    }\n\n    table,\n    td {\n      border-collapse: collapse;\n      mso-table-lspace: 0pt;\n      mso-table-rspace: 0pt;\n    }\n\n    img {\n      border: 0;\n      height: auto;\n      line-height: 100%;\n      outline: none;\n      text-decoration: none;\n      -ms-interpolation-mode: bicubic;\n    }\n\n    p {\n      display: block;\n      margin: 13px 0;\n    }\n\n  </style>\n  <!--[if mso]>\n    <noscript>\n    <xml>\n    <o:OfficeDocumentSettings>\n      <o:AllowPNG/>\n      <o:PixelsPerInch>96</o:PixelsPerInch>\n    </o:OfficeDocumentSettings>\n    </xml>\n    </noscript>\n    <![endif]-->\n  <!--[if lte mso 11]>\n    <style type=\"text/css\">\n      .mj-outlook-group-fix { width:100% !important; }\n    </style>\n    <![endif]-->\n  <style type=\"text/css\">\n    @media only screen and (min-width:600px) {\n      .mj-column-per-40 {\n        width: 40% !important;\n        max-width: 40%;\n      }\n\n      .mj-column-per-60 {\n        width: 60% !important;\n        max-width: 60%;\n      }\n\n      .mj-column-per-100 {\n        width: 100% !important;\n        max-width: 100%;\n      }\n\n\t  .mj-column-per-50 {\n        width: 50% !important;\n        max-width: 50%;\n      }\n\n      .mj-column-per-33-333333333333336 {\n        width: 33.333333333333336% !important;\n        max-width: 33.333333333333336%;\n      }\n\n\t  .mj-column-px-100 {\n        width: 100px !important;\n        max-width: 100px;\n      }\n\n      .mj-column-px-150 {\n        width: 150px !important;\n        max-width: 150px;\n      }\n\n      .mj-column-px-360 {\n        width: 360px !important;\n        max-width: 360px;\n      }\n    }\n\n  </style>\n  <style media=\"screen and (min-width:600px)\">\n    .moz-text-html .mj-column-per-40 {\n      width: 40% !important;\n      max-width: 40%;\n    }\n\n    .moz-text-html .mj-column-per-60 {\n      width: 60% !important;\n      max-width: 60%;\n    }\n\n    .moz-text-html .mj-column-per-100 {\n      width: 100% !important;\n      max-width: 100%;\n    }\n\n\t.moz-text-html .mj-column-per-50 {\n      width: 50% !important;\n      max-width: 50%;\n    }\n\n    .moz-text-html .mj-column-per-33-333333333333336 {\n      width: 33.333333333333336% !important;\n      max-width: 33.333333333333336%;\n    }\n\n\t.moz-text-html .mj-column-px-100 {\n      width: 100px !important;\n      max-width: 100px;\n    }\n\n    .moz-text-html .mj-column-px-150 {\n      width: 150px !important;\n      max-width: 150px;\n    }\n\n    .moz-text-html .mj-column-px-360 {\n      width: 360px !important;\n      max-width: 360px;\n    }\n\n  </style>\n  <style type=\"text/css\">\n    @media only screen and (max-width:599px) {\n      table.mj-full-width-mobile {\n        width: 100% !important;\n      }\n\n      td.mj-full-width-mobile {\n        width: auto !important;\n      }\n    }\n\n  </style>\n  <style type=\"text/css\">\n    div[data-container=\"main\"] {\n      /* Email builder compatability styles */\n      max-width: 600px;\n      margin: 0 auto;\n    }\n\n    body {\n      color: {replacement~text_color};\n      font-family: Arial, sans-serif;\n      font-size: 16px;\n    }\n\n    a {\n      color: {replacement~link_color};\n      font-weight: 700;\n    }\n\n    h1,\n    h2,\n    h3,\n    h4,\n    h5,\n    h6 {\n      color: {replacement~header_color};\n      font-family: Arial, sans-serif;\n    }\n\n    h1 {\n      font-size: 32px;\n      line-height: 1.1;\n    }\n\n    h2 {\n      font-size: 24px;\n      line-height: 1.1;\n    }\n\n    h3 {\n      font-size: 18px;\n      line-height: 1.1;\n    }\n\n    p {\n      font-size: 16px;\n      line-height: 1.6;\n    }\n\n\t.footer-text p {\n      font-size: 10px;\n    }\n\n    .footer-text a {\n\t  font-weight: 400;\n      color: #ffffff;\n    }\n\n    .wysiwyg>div>*:first-child {\n      margin-top: 0;\n    }\n\n    .wysiwyg>div>*:last-child {\n      margin-bottom: 0;\n    }\n\n    .mobile-only {\n      display: none !important;\n    }\n\n    @media (max-width: 599px) {\n      .responsive-col-padding>table>tbody>tr>td {\n        padding: 0 25px 20px !important;\n      }\n\n      .desktop-only {\n        display: none !important;\n      }\n\n      .signature-img {\n        width: 30% !important;\n      }\n\n      .signature-text {\n        width: 70% !important;\n      }\n\n      .header-block>table>tbody>tr>td {\n        padding: 20px 0 0 !important;\n      }\n\n      .header-block .button {\n        text-align: center !important;\n        padding: 24px 0 0 !important;\n      }\n\n      .header-block .button table {\n        width: 100% !important;\n      }\n\n      .header-block .button td {\n        border-radius: 0 !important;\n      }\n\n      .header-block .button a {\n        border-radius: 0 !important;\n        font-weight: bold !important;\n        width: 100% !important;\n        padding: 15px 0 !important;\n      }\n\n\t  .three-cta-button-block table {\n        width: 100% !important;\n      }\n    }\n\n    .hide-content {\n      display: none !important;\n      mso-hide: all;\n    }\n\n    .hide-content * {\n      display: none !important;\n      mso-hide: all;\n    }\n\n    /* dark mode styles */\n    :root {\n      color-scheme: light dark;\n      supported-color-schemes: light dark;\n    }\n\n    .dark-only {\n      display: none;\n    }\n\n    [data-ogsc] .dark-only {\n      display: block !important;\n    }\n\n    [data-ogsc] .light-only {\n      display: none !important;\n    }\n\n    @media (prefers-color-scheme: dark) {\n      .light-only {\n        display: none !important;\n      }\n\n      .dark-only {\n        display: block !important;\n      }\n\n      body,\n      .email-body {\n        color: #eeeeee !important;\n        background-color: #171819 !important;\n      }\n\n      a {\n        color: #9ca4a5 !important;\n      }\n\n      h1,\n      h2,\n      h3,\n      h4,\n      h5,\n      h6 {\n        color: #b0b4b5 !important;\n      }\n\n      .block,\n      .block>table,\n      .spacer-block td {\n        background-color: #0e0f0f !important;\n      }\n\n      .header-block.block,\n      .header-block.block>table {\n        background-color: #121314 !important;\n      }\n\n      .pre-footer-block.block,\n      .pre-footer-block.block>table {\n        background-color: #1f2021 !important;\n      }\n\n      .footer-menu-block.block,\n      .footer-menu-block.block>table {\n        background-color: #121314 !important;\n      }\n\n      .button td,\n      .button a {\n        background-color: #eaebec !important;\n        color: #121314 !important;\n      }\n\n      .card-block .card-inner td {\n        background-color: #1f2021 !important;\n      }\n\n      .side-by-side-card-block .card-inner>table table>tbody>tr>td {\n        background-color: #1f2021 !important;\n      }\n\t\t\n      .social-link table {\n        background-color: #b0b4b5 !important;\n      }\n\n      .social-link table td {\n        padding: 3px !important;\n      }\n\n\t  .divider>p {\n        border-color: #eeeeee !important;\n      }\n    }\n\n  </style>\n  <meta name=\"color-scheme\" content=\"light dark\">\n  <meta name=\"supported-color-schemes\" content=\"light dark\">\n</head>\n\n<body style=\"word-spacing:normal;background-color:{replacement~background_color};\">\n  <div class=\"email-body\" style=\"background-color:{replacement~background_color};\" lang=\"und\" dir=\"auto\">\n    <!-- START: Main Content -->\n\t  {{container~main}}\n\t<!-- END: Main Content -->\n  </div>\n</body>\n\n</html>\n","data":"{\"design\":[{\"name\":\"main\",\"blocks\":[]}],\"replacements\":{\"background_color\":{\"type\":\"Colour\",\"values\":{\"default\":{\"value\":\"#f4f4f4\"}},\"order\":0,\"label\":\"Background Color\",\"name\":\"background_color\",\"section\":\"Template\"},\"text_color\":{\"type\":\"Colour\",\"values\":{\"default\":{\"value\":\"#000000\"}},\"order\":1,\"label\":\"Text Color\",\"name\":\"text_color\",\"section\":\"Template\"},\"header_color\":{\"type\":\"Colour\",\"values\":{\"default\":{\"value\":\"#000000\"}},\"order\":2,\"label\":\"Header Color\",\"name\":\"header_color\",\"section\":\"Template\"},\"link_color\":{\"type\":\"Colour\",\"values\":{\"default\":{\"value\":\"#000000\"}},\"order\":3,\"label\":\"Link Color\",\"name\":\"link_color\",\"section\":\"Template\"}}}"}
